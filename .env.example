# Optional DS4 configuration for ./run.sh.
# Copy this file to .env only when ds4-server is already installed and running.
# A non-empty DS4_BASE_URL makes the one-command launcher try DS4 first.
# If DS4 cannot be reached, the complete run restarts with deterministic MockProvider.
DS4_BASE_URL=http://127.0.0.1:8000/v1
DS4_MODEL=deepseek-v4-flash
DS4_TIMEOUT_SECONDS=120

# Leave empty when the local server does not require authentication.
DS4_API_KEY=

# Optional explicit override for ./run.sh: auto, mock, or ds4.
# WATER_LAB_PROVIDER=auto
